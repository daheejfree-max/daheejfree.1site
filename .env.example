# ==============================================================================
# DAHEEJFREE — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env.local' for local development or configure them directly
# in your Vercel Project Settings (Settings -> Environment Variables).

# ------------------------------------------------------------------------------
# 1. APPLICATION & CANONICAL DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical production site URL used for OAuth redirects, WebRTC signaling origin checks, and email links.
# Set to your primary production domain on Vercel (https://daheejfree.site).
NEXT_PUBLIC_SITE_URL=https://daheejfree.site
NEXT_PUBLIC_APP_URL=https://daheejfree.site
APP_URL=https://daheejfree.site
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SUPABASE CREDENTIALS (AUTHENTICATION, DATABASE, REALTIME & STORAGE)
# ------------------------------------------------------------------------------
# Where to find in Supabase:
# Log in to https://supabase.com/dashboard -> Select Project -> Project Settings -> API

# [Frontend] Project URL: Found under "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# [Frontend] Public Anon Key: Found under "Project API keys" -> 'anon' / 'public' (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [Backend / Server-Side Only] Service Role Key: Found under "Project API keys" -> 'service_role' (secret).
# Used by Next.js API route handlers (/api/kyc/verify, webhooks) to safely bypass RLS. NEVER expose to the browser!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. DIDIT PROTOCOL (BIOMETRIC IDENTITY & KYC VERIFICATION GATEWAY)
# ------------------------------------------------------------------------------
# Where to find in Didit:
# Log in to Didit Business Console: https://business.didit.me -> API Keys / Developers

# [Backend] Live API Key for creating KYC verification sessions and evaluating liveness results
DIDIT_API_KEY=live_didit_api_key_xxxxxxxxxxxxxxxxxxxx
DIDIT_WORKFLOW_ID=your_didit_workflow_id

# [Backend] Optional Didit Application Credentials
DIDIT_CLIENT_ID=your_didit_client_id
DIDIT_CLIENT_SECRET=your_didit_client_secret

# [Backend] Webhook Secret configured in Didit Dashboard -> Webhooks targeting /api/kyc/webhook
DIDIT_WEBHOOK_SECRET=whsec_didit_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. DODO PAYMENTS (PRIMARY GLOBAL & MULTI-CURRENCY GATEWAY)
# ------------------------------------------------------------------------------
# Obtain from Dodo Payments Dashboard: https://app.dodopayments.com
# Live Production API Key
DODO_PAYMENTS_API_KEY=live_dodo_api_xxxxxxxxxxxxxxxxxxxx

# Webhook signing key to verify subscription updates sent to /api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY=whsec_dodo_xxxxxxxxxxxxxxxxxxxxxxxx

# Environment mode: 'production' for live payments or 'test_mode' for staging
NEXT_PUBLIC_DODO_PAYMENTS_ENVIRONMENT=production

# Live Dodo Payments API Base URL
DODO_BASE_URL=https://live.dodopayments.com

# Backward-compatible aliases
DODO_API_KEY=live_dodo_api_xxxxxxxxxxxxxxxxxxxx
DODO_WEBHOOK_SECRET=whsec_dodo_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENTS (INR CHECKOUT & UPI PAYMENTS)
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard: https://dashboard.razorpay.com -> Settings -> API Keys
# Public Key ID for Razorpay Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Secret Key for backend order creation and capture (Server-side only)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Secret configured in Razorpay Dashboard -> Webhooks for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional Razorpay Plan ID for recurring subscriptions
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI (SHARIAH MATCHMAKER & COMPATIBILITY ENGINE)
# ------------------------------------------------------------------------------
# Google AI Studio API key for matchmaking recommendations and profile assessments
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
